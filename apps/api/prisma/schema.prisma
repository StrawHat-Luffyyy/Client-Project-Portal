generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  PM
  ENGINEER
  CLIENT
}

enum RequirementPriority {
  LOW
  MEDIUM
  HIGH
}

enum RequirementStatus {
  SUBMITTED
  IN_REVIEW
  NEEDS_INFO
  APPROVED
  IN_PROGRESS
  DELIVERED
  REJECTED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum CommentVisibility {
  INTERNAL
  CLIENT_VISIBLE
}

enum EntityType {
  ORGANIZATION
  USER
  INVITE
  CLIENT
  PROJECT
  REQUIREMENT
  TASK
  COMMENT
  ATTACHMENT
  NOTIFICATION
}

model Organization {
  id            String         @id @default(cuid())
  name          String
  createdAt     DateTime       @default(now())
  users         User[]
  invites       Invite[]
  clients       Client[]
  projects      Project[]
  requirements  Requirement[]
  tasks         Task[]
  comments      Comment[]
  attachments   Attachment[]
  activityLogs  ActivityLog[]
  notifications Notification[]
}

model User {
  id                    String         @id @default(cuid())
  organizationId        String
  clientId              String?
  name                  String
  email                 String         @unique
  passwordHash          String
  role                  Role
  createdAt             DateTime       @default(now())
  organization          Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client                Client?        @relation(fields: [clientId], references: [id], onDelete: SetNull)
  createdRequirements   Requirement[]  @relation("RequirementCreator")
  assignedTasks         Task[]         @relation("TaskAssignee")
  comments              Comment[]
  uploadedAttachments   Attachment[]
  activityLogs          ActivityLog[]
  notifications         Notification[]

  @@index([organizationId])
  @@index([clientId])
  @@index([organizationId, role])
}

model Invite {
  id             String       @id @default(cuid())
  organizationId String
  clientId       String?
  email          String
  role           Role
  token          String       @unique
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client         Client?      @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, email])
}

model Client {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  contactEmail   String
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users          User[]
  invites        Invite[]
  projects       Project[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Project {
  id             String        @id @default(cuid())
  organizationId String
  clientId       String
  name           String
  description    String
  createdAt      DateTime      @default(now())
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client         Client        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  requirements   Requirement[]

  @@unique([organizationId, clientId, name])
  @@index([organizationId])
  @@index([clientId])
}

model Requirement {
  id              String              @id @default(cuid())
  organizationId  String
  projectId       String
  createdById     String
  title           String
  description     String
  priority        RequirementPriority
  status          RequirementStatus   @default(SUBMITTED)
  rejectionReason String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project         Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy       User                @relation("RequirementCreator", fields: [createdById], references: [id], onDelete: Restrict)
  tasks           Task[]
  comments        Comment[]
  attachments     Attachment[]

  @@index([organizationId])
  @@index([projectId, status])
  @@index([createdById])
}

model Task {
  id             String       @id @default(cuid())
  organizationId String
  idempotencyKey String?
  requirementId  String
  title          String
  description    String
  status         TaskStatus   @default(TODO)
  assigneeId     String?
  estimateHours  Decimal?     @db.Decimal(6, 2)
  dueDate        DateTime?
  position       Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requirement    Requirement  @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  assignee       User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  comments       Comment[]

  @@index([organizationId])
  @@unique([organizationId, idempotencyKey])
  @@index([requirementId, status])
  @@index([assigneeId, status])
}

model Comment {
  id             String            @id @default(cuid())
  organizationId String
  authorId       String
  requirementId  String?
  taskId         String?
  parentId       String?
  body           String
  visibility     CommentVisibility
  createdAt      DateTime          @default(now())
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  author         User              @relation(fields: [authorId], references: [id], onDelete: Restrict)
  requirement    Requirement?      @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  task           Task?             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  parent         Comment?          @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies        Comment[]         @relation("CommentReplies")

  @@index([organizationId])
  @@index([requirementId, createdAt])
  @@index([taskId, createdAt])
  @@index([parentId])
}

model Attachment {
  id             String       @id @default(cuid())
  organizationId String
  requirementId  String
  fileName       String
  storageKey     String       @unique
  size           Int
  uploadedById   String
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requirement    Requirement  @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  uploadedBy     User         @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([requirementId])
}

model ActivityLog {
  id             String       @id @default(cuid())
  organizationId String
  actorId        String
  entityType     EntityType
  entityId       String
  action         String
  metadata       Json
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor          User         @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([entityType, entityId, createdAt])
}

model Notification {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  type           String
  entityType     EntityType
  entityId       String
  readAt         DateTime?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([userId, readAt, createdAt])
}
